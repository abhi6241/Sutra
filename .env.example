# Primary LLM provider
GEMINI_API_KEY=

# Fallback providers, tried in order after Gemini: Groq, then Ollama Cloud
GROQ_API_KEY=
OLLAMA_API_KEY=

# Optional legacy fallbacks (paid) — leave unset to skip
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend API URL (for Vercel/production deployment)
# Leave empty for local development (uses Vite proxy)
# VITE_API_URL=https://your-backend.up.railway.app
