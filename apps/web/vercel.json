{
  "rewrites": [
    { "source": "/chat", "destination": "/api" },
    { "source": "/approve", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/inbox/:path*", "destination": "/api" },
    { "source": "/calendar/:path*", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/api" },
    { "source": "/stream/:path*", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/stream/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ]
}
